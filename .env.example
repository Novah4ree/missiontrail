# Required by the Expo client for authenticated Supabase Edge Function calls.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key

# Development-only convenience flag. Production still hides the button through __DEV__.
EXPO_PUBLIC_ENABLE_RELIC_TEST_MODE=false

# Optional. Mission steps activate only after validated GPS plus its accuracy
# radius is inside this many meters from the selected trailhead.
EXPO_PUBLIC_TRAILHEAD_PROXIMITY_RADIUS_METERS=500

# The deployed trail-discovery Edge Function also needs the standard Supabase
# server secrets plus GEOAPIFY_API_KEY for user-to-trailhead route previews.
# Set server secrets with `supabase secrets set`; do not expose them as EXPO_PUBLIC_ values.
# Optional server setting: TRAIL_DISCOVERY_RATE_LIMIT_PER_MINUTE=20
