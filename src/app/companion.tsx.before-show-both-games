            shop={foodShop}
            shopLoading={shopLoading}
            buyingFoodId={buyingFoodId}
            onBack={returnHome}
            onPanelChange={(nextPanel) => {
              setFoodPanel(nextPanel);
              setFeedMessage(null);
              setSelectedFoodId(null);
            }}
            onSelectFood={(foodId) => {
              const quantity =
                foodInventory[foodId] ?? 0;

              if (quantity <= 0) {
                const food =
                  FOOD_PREVIEWS.find(
                    (item) =>
                      item.id === foodId,
                  );

                setFeedMessage(
                  `${food?.name ?? 'This food'} is locked. Earn it from missions or buy it in the Shop.`,
                );
                return;
              }

              setSelectedFoodId(foodId);
              setFeedMessage(null);
            }}
            onFeed={() =>
              void feedSelectedFood()
            }
            onBuy={(foodId) =>
              void purchaseFood(foodId)
            }
          />
        ) : null}

        {view === 'evolve' ? (
          <EvolveView
