function Meter({
  value,
  color,
}: {
  value: number;
  color: string;
}) {
  const safeValue =
    Math.min(100, Math.max(0, value));

  return (
    <View
      accessibilityRole="progressbar"
      accessibilityValue={{
        min: 0,
        max: 100,
        now: safeValue,
      }}
      style={styles.meterTrack}
    >
      <View
        style={[
          styles.meterFill,
          {
            width: `${safeValue}%`,
            backgroundColor: color,
          },
        ]}
      />
    </View>
  );
}

function capitalize(
  value: string | null | undefined,
) {
  if (!value) return 'Unknown';

  return (
    value.charAt(0).toUpperCase() +
    value.slice(1)
  );
}


