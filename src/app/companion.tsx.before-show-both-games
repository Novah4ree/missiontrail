          {
            paddingTop: safeArea.top + 14,
            paddingBottom: safeArea.bottom + 190,
          },
        ]}
      >
        {view === 'home' ? (
          <HomeView
            companionName={companionName}
            companionDefinition={companionDefinition}
            isLoading={isLoading}
            hasCompanion={Boolean(effectiveCompanionId)}
            bondPercent={bondPercent}
