{
  "expo": {
    "name": "MissionTrail0.2",
    "slug": "MissionTrail02",
    "version": "1.0.0",
    "orientation": "portrait",

    "icon": "./assets/images/splash-icon.png",

    "scheme": "missiontrail02",
    "userInterfaceStyle": "automatic",

    "ios": {
      "icon": "./assets/images/splash-icon.png",
      "bundleIdentifier": "com.anonymous.MissionTrail0.x2",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Allow Mission Trails to use your location to find nearby trails and track trails you choose to start.",
        "NSMotionUsageDescription": "Mission Trails uses motion activity to count your steps and track walking progress during missions.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },

    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },

      "predictiveBackGestureEnabled": false,

      "package": "com.anonymous.MissionTrail0.x2",

      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },

    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },

    "plugins": [
      "expo-router",

      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash_screen.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#208AEF"
        }
      ],

      "expo-font",

      [
        "expo-sensors",
        {
          "motionPermission": "Mission Trails uses motion activity to count your steps and track walking progress during missions."
        }
      ],

      "expo-web-browser",

      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Mission Trails to use your location for nearby trails and verified GPS trail tracking.",
          "locationWhenInUsePermission": "Allow Mission Trails to use your location for nearby trails and verified GPS trail tracking."
        }
      ],

      [
        "@react-native-voice/voice",
        {
          "microphonePermission": "Allow MissionTrail to use the microphone for voice commands.",
          "speechRecognitionPermission": "Allow MissionTrail to convert your voice commands to text."
        }
      ],

      "expo-audio",
      "expo-asset"
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },

    "extra": {
      "router": {},
      "eas": {
        "projectId": "b366ec28-52fa-420f-9c80-ac7defb84e3c"
      }
    },

    "owner": "novah2118"
  }
}
